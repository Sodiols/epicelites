# Copy to .env.local for development. In production, set these in your host (e.g. Vercel).

# Supabase project URL: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key: Project Settings > API Keys > Publishable key (sb_publishable_...)
# Older projects can use the legacy anon key instead via NEXT_PUBLIC_SUPABASE_ANON_KEY.
# Both are safe to expose: Row Level Security decides what they can do.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public origin, no trailing slash. Used for password-reset links, canonical URLs,
# the sitemap and Open Graph images. Example: https://epicelites.gg
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: upload size limit in MB (server check and dashboard hint). Default 10.
# Keep it at or below the bucket's file_size_limit (10 MB in the migration).
MEDIA_MAX_UPLOAD_MB=10
NEXT_PUBLIC_MEDIA_MAX_UPLOAD_MB=10

# Cloudflare Turnstile on the contact form. The site key is public; the secret is not.
# Get the secret from Cloudflare > Turnstile > your widget > Settings, and set it only in
# .env.local and your host's secret settings, never in git.
# Once either key is set, every submission must pass verification (it fails closed).
#
# Local development: Cloudflare widgets cannot list localhost, so use Cloudflare's public
# test keys below. The server accepts test-key results only outside production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost
#
# Production (set in your host, not here): the real widget's site key, its secret, and your
# real domains (e.g. epicelites.gg,www.epicelites.gg), which must also be listed on the widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFiyKoePy1cMAbWZ
# TURNSTILE_SECRET_KEY=<from Cloudflare>
# TURNSTILE_HOSTNAMES=epicelites.gg,www.epicelites.gg

# Never put a Supabase secret or service_role key in this project. It is not needed.
